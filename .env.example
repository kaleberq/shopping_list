# Copie para a raiz do projeto: cp .env.example .env
# O arquivo .env está no .gitignore — nunca commite credenciais.

PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=shopping_list
DATABASE_PASSWORD=shopping_list
DATABASE_NAME=shopping_list
TYPEORM_SYNC=true

JWT_SECRET=dev-only-change-in-production-use-at-least-32-chars
JWT_EXPIRATION_MINUTES=60
VERIFICATION_CODE_EXPIRATION_MINUTES=15

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=email@gmail.com
MAIL_PASSWORD=xxxxxx
MAIL_FROM=email@gmail.com
MAIL_VERIFICATION_SUBJECT=Codigo de verificacao - Shopping List

# Compatibilidade com o .env antigo do Spring (opcional):
# spring.mail.username=
# spring.mail.password=
# app.mail.from=
